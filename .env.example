OPENAI_API_KEY=sk-proj-your-openai-api-key
PORT=5050
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_REASONING_EFFORT=low
# UIからRealtimeモデルを切り替えた場合、FirestoreのruntimeSettings/adminに保存されます。
RUNTIME_SETTINGS_FIRESTORE_COLLECTION=runtimeSettings
RUNTIME_SETTINGS_FIRESTORE_DOCUMENT_ID=admin
REALTIME_CHECK_TIMEOUT_MS=10000
REALTIME_BENCHMARK_MODELS=gpt-realtime-2.1,gpt-realtime-2
REALTIME_BENCHMARK_ITERATIONS=3
REALTIME_BENCHMARK_TIMEOUT_MS=15000
REALTIME_BENCHMARK_WRITE_LOG=true
TRANSCRIPTION_MODEL=gpt-4o-transcribe
EXTRACTION_MODEL=gpt-5.4-mini
EXTRACTION_ENABLED=false
VOICE=coral
AUDIO_FORMAT=audio/pcmu
AUDIO_NOISE_REDUCTION=near_field
VAD_TYPE=server_vad
VAD_THRESHOLD=0.65
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_DURATION_MS=700
VAD_EAGERNESS=low
VAD_CREATE_RESPONSE=true
VAD_INTERRUPT_RESPONSE=true
# trueの場合、RealtimeのVAD自動応答を止め、文字起こし完了後に低信号発話を除外してから応答します。
REALTIME_INPUT_GATE_ENABLED=true
REALTIME_INPUT_GATE_MIN_JAPANESE_CHARS=2
REALTIME_INPUT_GATE_MIN_DIGITS=4
REALTIME_INPUT_GATE_ALLOWED_TERMS=PC,Wi-Fi,WiFi,Windows,Mac,Excel,Word,Outlook
CALL_END_WORKFLOW_ENABLED=true
CALL_END_HANGUP_ENABLED=true
CALL_END_FINAL_PHRASE=このあとお電話をお切りいただいて大丈夫です。失礼いたします。
CALL_END_MARK_TIMEOUT_MS=5000
CALL_END_GRACE_MS=800
LOG_TRANSCRIPTS=false
LOG_REALTIME_EVENTS=false
LOG_OPENAI_RESPONSES=false

# === Admin UI ===
# /app and /api/admin/* use HTTP Basic Auth. Set both values in any deployed environment.
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change-me

# === Twilio ===
# 本番運用ではTwilio AccountのAuth Tokenを使用 (Twilio CLIのAPI Key Secretでは署名検証できない)
TWILIO_AUTH_TOKEN=
TWILIO_SIGNATURE_VALIDATION_ENABLED=false
TWILIO_WEBHOOK_URL=https://your-app.run.app/incoming-call
TWILIO_PUBLIC_BASE_URL=https://your-app.run.app

# === DTMF gateway ===
DTMF_GATEWAY_ENABLED=false
PRACTICE_SYSTEM_REDIRECT_URL=https://phone-training-system.run.app/incoming-call
DTMF_GATEWAY_TIMEOUT_S=2

# === PSTN human handoff ===
HANDOFF_ENABLED=false
# JSON: {"contract":"+81...","general":"+81..."}; legacy CSV is also accepted.
# Production phone numbers belong in Secret Manager, not in this file.
HANDOFF_NUMBERS=
HANDOFF_DIAL_TIMEOUT_S=20
HANDOFF_WHISPER_ACCEPT_DIGIT=1
HANDOFF_CALLER_ID=

# === Google Cloud ===
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# === Firestore call log ===
CALL_LOG_FIRESTORE_ENABLED=false
CALL_LOG_FIRESTORE_DATABASE_ID=your-firestore-database-id
CALL_LOG_FIRESTORE_COLLECTION=callLogs
CALL_LOG_SUPPRESS_SMOKE_LOGS=true

# === Google Sheets call log (運用ビュー) ===
CALL_LOG_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_RANGE=

# === Resend notification outbox ===
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_TO=cloudia@cor-jp.com
NOTIFY_EMAIL_CC=company@cor-jp.com,k.isayama@cor-jp.com,nagisa.terada@cor-jp.com
NOTIFY_EMAIL_FROM=noreply@cor-jp.com
# RESEND_API_KEY is injected from Secret Manager.

# === System message (override per deployment) ===
# SYSTEM_MESSAGE=
# SYSTEM_MESSAGE_FILE=
# FIRST_MESSAGE=お電話ありがとうございます。Cor.株式会社コールセンターです。ご用件をお聞かせください。
